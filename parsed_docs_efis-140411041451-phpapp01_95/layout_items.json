    "source_type": "text"
  },
  {
    "layout_id": "page-13:text-3",
    "page_id": 13,
    "layout_type": "text",
    "asset_ref": null,
    "bbox_norm": [
      0.232,
      0.045,
      0.317,
      0.325
    ],
    "text": "Each block representsa system.",
    "source_type": "text"
  },
  {
    "layout_id": "page-13:text-4",
    "page_id": 13,
    "layout_type": "text",
    "asset_ref": null,
    "bbox_norm": [
      0.434,
      0.044,
      0.557,
      0.289
    ],
    "text": "Lines represent connectionsbetween systems.",
    "source_type": "text"
  },
  {
    "layout_id": "page-13:text-5",
    "page_id": 13,
    "layout_type": "text",
    "asset_ref": null,
    "bbox_norm": [
      0.675,
      0.045,
      0.758,
      0.346
    ],
    "text": "Arrows represent direction of flow.",
    "source_type": "text"
  },
  {

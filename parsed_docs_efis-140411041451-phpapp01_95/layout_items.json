    "layout_type": "text",
    "asset_ref": null,
    "bbox_norm": [
      0.041,
      0.039,
      0.109,
      0.805
    ],
    "text": "Common rail and Pressure sensor",
    "source_type": "text"
  },
  {
    "layout_id": "page-18:text-2",

    "asset_ref": null,
    "bbox_norm": [
      0.244,
      0.037,
      0.338,
      0.459
    ],
    "text": "Proximity. We tend to see objects that are visually close together as belonging to part of a group.",
    "source_type": "text"
  },
  {
    "layout_id": "page-2:text-3",
    "page_id": 2,
